pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/Vipulc714/Zomato.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build React App') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t zomato-app:v1 .'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                docker rm -f zomato-app || true
                docker run -d --name zomato-app -p 3001:3000 zomato-app:v1
                '''
            }
        }
    }
}
