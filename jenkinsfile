pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/Vipulc714/Zomato.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build React App') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t zomato-app:v1 .'
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                docker tag zomato-app:v1 vipulc714/zomato-app:latest
                docker push vipulc714/zomato-app:latest
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@13.203.97.206 << 'EOF'
                sudo KUBECONFIG=/etc/kubernetes/admin.conf kubectl rollout restart deployment/zomato
                sudo KUBECONFIG=/etc/kubernetes/admin.conf kubectl rollout status deployment/zomato
                EOF
                '''
            }
        }
    }
}
